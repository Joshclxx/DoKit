# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Capacitor / Android build output
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties

# Superseded Android installers (the current APK remains tracked for the mobile download page)
/public/downloads/dokit-android-v1.0.0-debug.apk
/public/downloads/dokit-android-v1.0.1-debug.apk

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
